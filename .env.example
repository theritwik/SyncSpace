# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=syncspace
POSTGRES_PASSWORD=syncspace_dev_password
POSTGRES_DB=syncspace
POSTGRES_PORT=5432

# Database connection used by Prisma and the API. Must match the values above.
DATABASE_URL=postgresql://syncspace:syncspace_dev_password@localhost:5432/syncspace?schema=public

# API (apps/api)
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
# Origin of the web app. The API rejects state-changing requests from other origins (CSRF).
WEB_ORIGIN=http://localhost:3000
# How long a login session stays valid.
SESSION_TTL_DAYS=7
# Read the client IP from X-Forwarded-For (needed for per-client rate limiting,
# because browsers reach the API through the web app). Only enable when the
# API is not directly reachable from the internet.
TRUST_PROXY=true

# Collaboration service (apps/collaboration)
COLLABORATION_HOST=0.0.0.0
COLLABORATION_PORT=4001
# How often open editor connections are re-checked against the database
# (logout, removal from a workspace, role change, deleted document).
COLLABORATION_ACCESS_RECHECK_SECONDS=30

# Shared by the API (signs) and the collaboration service (verifies): the key
# for the short-lived tokens that let a browser open an editor connection.
# At least 32 characters. Generate your own, e.g. `openssl rand -base64 48`.
COLLABORATION_TOKEN_SECRET=dev-only-collaboration-secret-change-me-0123456789

# Web (apps/web): base URL of the API, used server-side and to forward /api/v1/*
API_URL=http://localhost:4000
# WebSocket URL of the collaboration service as the browser reaches it
COLLABORATION_URL=ws://localhost:4001
